+    ordinary, payloads = indexed_archive(raws)
+    link = next(row for row in ordinary['evidence'] if row['kind'] == 'indexed-page')
+    return {'kind': 'indexed-page', 'hash': link['hash'], 'payload': payloads[link['hash']]}
